   "source": [
    "## Run the Human SAGE peptide quantification\n",
    "import subprocess\n",
    "import shlex\n",
    "\n",
    "config = \"/home/jovyan/data-store/home/shared/NCEMS/CURE-2025/Comparative_massSpec/data/Human_sage_silac_config.json\"\n",
    "cmd = f\"sage {config} -o /home/jovyan/data-store/CURE2025_Comparative_massSpec/Human_SAGE_results/\"\n",
    "\n",
    "try:\n",
    "    result = subprocess.run(\n",
    "        shlex.split(cmd),\n",
    "        capture_output=True,           # capture stdout/stderr\n",
    "        text=True,                     # decode to str\n",
    "        check=True,                   # raise on non-zero exit\n",
    "        timeout=60000,                  # seconds, adjust if search is long\n",
    "    )\n",
    "    print(\"=== STDOUT ===\")\n",
    "    print(result.stdout)\n",
    "    print(\"=== STDERR ===\")\n",
    "    print(result.stderr)\n",
    "except subprocess.CalledProcessError as e:\n",
    "    print(f\"Command failed with exit code {e.returncode}\")\n",
    "    print(\"=== STDOUT ===\")\n",
    "    print(e.stdout)\n",
    "    print(\"=== STDERR ===\")\n",
    "    print(e.stderr)\n",
    "except subprocess.TimeoutExpired as e:\n",
    "    print(\"Command timed out\")\n",
    "    print(\"Partial output:\", e.stdout)"
   ]
  },
