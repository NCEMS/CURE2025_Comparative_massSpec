      "4                 1.056502e+08                 3.691432e+08   \n",
      "\n",
      "   Soybean_LPBiomaker_HP1.mzML     uniprot  \n",
      "0                 3.796642e+06  A0A0R0IFL4  \n",
      "1                 3.796642e+06      I1MQN4  \n",
      "2                 4.760074e+08  A0A0R0GHB3  \n",
