    "## Load the data into a Pandas DataFrame and print the top 10 rows of the dataframe\n",
    "df = pd.read_csv(DATA, sep=\"\\t\")\n",
    "print(f'Loaded: {DATA}')\n",
    "print(df.head())\n",
    "\n",
    "## Filter the DataFrame based on q-value\n",
    "df = df[df['q_value'] <= 0.05]  # Filter by q-value threshold\n",
